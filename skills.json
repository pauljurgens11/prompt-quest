{
  "_help": "Edit freely, the tracker rescans history by itself after a change. Tool calls go to the FIRST skill whose rule matches (so put specific rules above general ones). A prompt counts once per skill whose rule matches. prompt kinds: turn (a new message), midturn (sent while the agent works), interrupt (you pressed stop). xp_since: only work after this moment earns XP (history before it is still used to learn your typical day). Delete it to count all history. loot: chest drop rates, chest odds per rarity [common, rare, ultra, extraordinary] and the drop table (kinds: item, gold, pet, aura, title, voucher = a free real-life reward from the shop). rewards: your real-life shop; set names and gold prices to whatever you will actually treat yourself to. A drop with a price is also sold in the shop. loot_since: coins and the streak count from this moment.",
  "balance": {
    "xp_per_typical_day": 1000,
    "grind_soft_cap": 2,
    "max_day_multiple": 12,
    "calibration_min_days": 5
  },
  "curve": {
    "max_level": 99,
    "xp_at_max": 1852132,
    "ratio": 1.07791,
    "_note": "fitted so a third of a normal day (300 XP) reaches level 4 and 365 maxed-out days (3,000 XP each) reach level 92"
  },
  "skills": [
    {
      "id": "prompting",
      "name": "Prompting",
      "icon": "💬",
      "about": "Every message you send: new prompts, mid-turn corrections, interrupts. Longer prompts earn a little more.",
      "rules": [
        {
          "prompt": [
            "turn",
            "midturn"
          ],
          "weight": 1,
          "chars_bonus_per": 400,
          "chars_bonus_max": 2
        },
        {
          "prompt": [
            "interrupt"
          ],
          "weight": 0.5
        }
      ],
      "group": "you"
    },
    {
      "id": "afk",
      "name": "AFK Coding",
      "icon": "💤",
      "about": "Minutes your agents and their subagents work on their own between your messages.",
      "rules": [
        {
          "afk_minutes": true,
          "gap_cap_seconds": 1800
        }
      ]
    },
    {
      "id": "wispr",
      "name": "Wispr Flow",
      "icon": "🎙️",
      "about": "Words you dictate with Wispr Flow (counts only, never the text).",
      "rules": [
        {
          "wispr_words": true
        }
      ]
    },
    {
      "id": "messaging",
      "name": "Messaging",
      "icon": "📨",
      "about": "Active minutes with Slack or WhatsApp in front (idle time does not count), plus minutes in calls: Meet, Zoom, Teams, huddles (any app holding the microphone over 2 minutes). A call minute counts double.",
      "rules": [
        {
          "app_minutes": "(?i)slack|whatsapp",
          "default_typical": 60
        },
        {
          "app_minutes": "^meeting$",
          "weight": 2
        }
      ]
    },
    {
      "id": "shipping",
      "name": "Shipping",
      "icon": "🚀",
      "about": "Pull requests you (or your agents, on your GitHub account) got merged. Read from GitHub.",
      "rules": [
        {
          "github_merged_prs": true,
          "author": "@me",
          "check_every_minutes": 10
        }
      ],
      "pace": 0.4,
      "_pace_note": "0.4: a normal day is about 50 merged PRs (the median was 19 back in September, so every day hit the cap)"
    }
  ],
